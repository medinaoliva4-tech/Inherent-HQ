#!/usr/bin/env bash
# Inicia sesión de Claude (cliente oficial) PARA UNA PERSONA, en su propio HOME del servidor. La hace cada persona
# con SU cuenta: abre el enlace que sale en pantalla en tu navegador e inicia sesión ahí. Este script nunca pide
# ni lee contraseñas ni tokens.   Uso: code-os-login <usuario>
set -euo pipefail
id="${1:?Uso: code-os-login <usuario>}"
data="${PUENTE_DATA_DIR:-$HOME/code-os-data}"
[ -d "$data/users/$id" ] || { echo "✗ No existe el usuario '$id'. Créalo antes: asistente.sh usuario $id"; exit 1; }
command -v claude >/dev/null || { echo "✗ Falta el cliente oficial: sudo npm i -g @anthropic-ai/claude-code"; exit 1; }
export HOME="$data/users/$id/home" CLAUDE_CONFIG_DIR="$data/users/$id/home/.claude"
chmod 700 "$HOME"
claude auth login
claude auth status --json | grep -q '"loggedIn": true' && echo "✓ Sesión de Claude activa para $id: su nivel alto ahora corre con su suscripción." || echo "✗ No quedó la sesión. Vuelve a correr: code-os-login $id"
