[Unit]
Description=Code OS · medidor de cuotas
After=network-online.target litellm.service
[Service]
User=deploy
WorkingDirectory=/home/deploy/gateway/cuotas
Environment=CUOTAS_EVENTOS=/home/deploy/gateway/cuotas/eventos.jsonl
Environment=CUOTAS_LIMITES=/home/deploy/gateway/cuotas/limites.json
Environment=CUOTAS_AVISOS=/home/deploy/gateway/cuotas/avisos.jsonl
Environment=CUOTAS_PUERTO=4200
ExecStart=/usr/bin/env node /home/deploy/gateway/cuotas/servidor.mjs
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
