{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "deepseek-direct": {
      "name": "DeepSeek directo",
      "env": ["DEEPSEEK_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "https://api.deepseek.com/v1" },
      "models": {
        "flash": {
          "modelID": "deepseek-flash",
          "name": "DeepSeek Flash",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 131072, "output": 8192 }
        },
        "pro": {
          "modelID": "deepseek-v4-pro",
          "name": "DeepSeek V4 Pro",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 131072, "output": 8192 }
        }
      }
    },
    "inherent-gateway": {
      "name": "Inherent Gateway",
      "env": ["INHERENT_GATEWAY_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "http://127.0.0.1:4010/v1" },
      "models": {
        "alto": { "modelID": "nivel-alto", "name": "Planear", "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }, "limit": { "context": 131072, "output": 8192 } },
        "medio": { "modelID": "nivel-medio", "name": "Ejecutar", "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }, "limit": { "context": 131072, "output": 8192 } },
        "bajo": { "modelID": "nivel-bajo", "name": "Económico", "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }, "limit": { "context": 131072, "output": 8192 } }
      }
    }
  }
}
