{
  "framework": null,
  "buildCommand": "node scripts/snapshot.mjs",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/event-stream.*"
        }
      ],
      "destination": "/api/index?route=mcp&at=root"
    },
    {
      "source": "/mcp",
      "destination": "/api/index?route=mcp"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/api/index?route=.well-known/:path*"
    },
    {
      "source": "/diagnostico",
      "destination": "/diagnostico.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; manifest-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleusercontent.com https://drive.google.com https://*.cdninstagram.com https://*.fbcdn.net https://*.tiktokcdn.com https://*.tiktokcdn-us.com https://i.pinimg.com https://i.ytimg.com https://media.licdn.com; connect-src 'self' https://www.googleapis.com http://127.0.0.1:7357 http://127.0.0.1:11434 http://127.0.0.1:8642; media-src 'self' blob: https://drive.google.com https://*.cdninstagram.com https://*.fbcdn.net; frame-src https://drive.google.com https://docs.google.com https://www.youtube.com https://player.vimeo.com https://www.loom.com https://www.instagram.com https://www.tiktok.com https://open.spotify.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/api/((?!media/|content/stream).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/laya/(instalar\\.sh|instalar\\.ps1|puente\\.py)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/diagnostico(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "api/_data/**",
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/scrape",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/settle",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/recurrentes",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/avisos",
      "schedule": "30 13 * * 1-5"
    }
  ]
}
